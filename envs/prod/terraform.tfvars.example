# Copier en terraform.tfvars (ignore par Git) et renseigner. Ne jamais mettre de secret ici.
owner            = "abc"
environment      = "prod"
vpc_cidr         = "10.1.0.0/16"
instance_type    = "t3.small"
min_size         = 2
max_size         = 6
desired_capacity = 3

# Secret : db_password ne se met JAMAIS dans ce fichier.
# Il se passe par l'environnement, saisie masquee :
#   read -rs TF_VAR_db_password && export TF_VAR_db_password
# (en CI : secret GitHub DB_PASSWORD, expose en TF_VAR_db_password)
# Rotation : augmenter db_password_version (par defaut 1).
# db_password_version = 1
